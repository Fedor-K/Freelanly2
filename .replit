[deployment]
deploymentTarget = "gce"
run = ["sh", "-c", "NODE_OPTIONS='--openssl-legacy-provider' npm run start -- -p 5000 -H 0.0.0.0"]
build = ["npm", "run", "build"]

# ============================================
# SCHEDULED TASKS (Cron Jobs)
# ============================================

# INSTANT job alerts - every 5 minutes
# Sends email when new job matches user's alert criteria
[[deployment.scheduled]]
trigger = "*/5 * * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/process-instant-alerts"
headers = { x-replit-cron = "true" }

# Trial onboarding emails - every hour
# Sends emails on Day 0, 2, 5, 6, 7 after registration
[[deployment.scheduled]]
trigger = "0 * * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/send-trial-emails"
headers = { x-replit-cron = "true" }

# Activation drip emails - every hour
# Sends Day 1, 2, 3 emails to PRO users with 0 applications
[[deployment.scheduled]]
trigger = "30 * * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/send-activation-emails"
headers = { x-replit-cron = "true" }

# FREE user nurture emails - every hour
# Sends Day 1, 3, 7 emails to FREE users to convert to PRO
[[deployment.scheduled]]
trigger = "45 * * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/send-free-nurture"
headers = { x-replit-cron = "true" }

# Re-engagement emails - daily at 9:00 UTC
# Sends emails to users inactive for 7, 14, 30 days
[[deployment.scheduled]]
trigger = "0 9 * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/send-reengagement-emails"
headers = { x-replit-cron = "true" }

# Win-back emails - daily at 10:00 UTC
# Sends emails to churned subscribers on Day 7, 14, 30
[[deployment.scheduled]]
trigger = "0 10 * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/send-winback-emails"
headers = { x-replit-cron = "true" }

# ============================================
# JOB FETCHING & ALERTS
# ============================================

# Fetch ATS sources - 3x daily at 6:00, 14:00, 22:00 UTC
# Imports jobs from Lever and other ATS sources
[[deployment.scheduled]]
trigger = "0 6 * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/fetch-sources"
headers = { x-replit-cron = "true" }

[[deployment.scheduled]]
trigger = "0 14 * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/fetch-sources"
headers = { x-replit-cron = "true" }

[[deployment.scheduled]]
trigger = "0 22 * * *"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/fetch-sources"
headers = { x-replit-cron = "true" }

# DAILY alerts removed - all alerts are now INSTANT
# INSTANT alerts are processed via /api/cron/process-instant-alerts (every 5 min)

# ============================================
# LEVER COMPANY DISCOVERY
# ============================================

# Discover new Lever companies - weekly on Sunday at 3:00 UTC
# Uses Apify Google Search to find companies using Lever ATS
[[deployment.scheduled]]
trigger = "0 3 * * 0"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/discover-lever"
headers = { x-replit-cron = "true" }

# Discover new Greenhouse companies - weekly on Sunday at 4:00 UTC
# Uses Apify Google Search to find companies using Greenhouse ATS
[[deployment.scheduled]]
trigger = "0 4 * * 0"
action = "http"
[deployment.scheduled.http]
method = "POST"
path = "/api/cron/discover-greenhouse"
headers = { x-replit-cron = "true" }

        "batchSize": 1,
        "options": {}
      },
      "id": "split-batch-001",
      "name": "Loop Posts",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [272, 480],
      "typeVersion": 3
    },
    {
      "parameters": {
        "url": "=https://api.linkedin.com/v2/socialActions/{{ encodeURIComponent($json.postUrn) }}/comments?projection=(elements*(id,actor~(localizedFirstName,localizedLastName,localizedHeadline),message,created,commentUrn))",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "fetch-comments-001",
      "name": "Fetch Comments",
      "type": "n8n-nodes-base.httpRequest",
      "position": [496, 480],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst elements = input.elements || [];\nconst postUrn = $('Loop Posts').first().json.postUrn;\nconst postText = $('Loop Posts').first().json.postText;\nconst ownOrgUrn = 'urn:li:organization:53520294';\n\n// Filter out own org comments, keep only external\nconst external = elements.filter(c => c.actor !== ownOrgUrn);\n\nif (external.length === 0) {\n  return [{ json: { noComments: true, postUrn } }];\n}\n\nreturn external.map(c => {\n  const profile = c['actor~'] || {};\n  const firstName = profile.localizedFirstName || '';\n  const lastName = profile.localizedLastName || '';\n  return {\n    json: {\n      commentUrn: c.commentUrn || ('urn:li:comment:(' + postUrn + ',' + c.id + ')'),\n      commentId: c.id,\n      authorUrn: c.actor,\n      authorName: [firstName, lastName].filter(Boolean).join(' ') || 'there',\n      authorHeadline: profile.localizedHeadline || '',\n      commentText: c.message?.text || '',\n      createdTime: c.created?.time || 0,\n      postUrn,\n      postText\n    }\n  };\n});"
      },
      "id": "extract-comments-001",
      "name": "Extract Comments",
      "type": "n8n-nodes-base.code",

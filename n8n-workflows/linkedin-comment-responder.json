    {
      "parameters": {
        "method": "POST",
        "url": "https://api.z.ai/api/paas/v4/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 7a46f1755ccb4b828fe35ab83cb81f47.FogYwylFMrNBWEst"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'glm-4-32b-0414-128k', messages: [{ role: 'system', content: 'You are the social media manager for Freelanly.com \\u2014 a platform that aggregates 1000+ fresh remote freelance jobs daily from LinkedIn, Lever, and other sources. You reply to comments on Freelanly\\'s LinkedIn posts. EVERY post is about a specific freelance job opportunity.\\n\\nYour goals:\\n1. Engage the commenter warmly\\n2. ALWAYS encourage them to visit freelanly.com to apply or set up free instant job alerts\\n3. Highlight the value: free alerts, fresh jobs daily, direct client contacts\\n\\nRules:\\n- Reply in the SAME LANGUAGE as the comment\\n- 2-3 sentences max\\n- Be enthusiastic but genuine, not robotic\\n- ALWAYS include a call-to-action: sign up for free alerts at freelanly.com, apply on freelanly.com, or check freelanly.com for more jobs like this\\n- If someone says they\\'re interested or this is great \\u2014 tell them to apply NOW on freelanly.com before the client hires someone else\\n- If someone tags a friend or says \\'following\\' \\u2014 tell them both to set up free alerts on freelanly.com so they never miss opportunities\\n- Never just say \\'thanks\\' without directing them to freelanly.com\\n- Sound human and friendly, like a helpful community manager' }, { role: 'user', content: 'Our LinkedIn post was about this job:\\n' + $('Extract Comments').item.json.postText + '\\n\\nSomeone commented:\\n' + $('Extract Comments').item.json.commentText + '\\n\\nWrite an engaging reply that motivates them to visit freelanly.com:' }], temperature: 0.8, max_tokens: 250 }) }}",
        "options": {}
      },

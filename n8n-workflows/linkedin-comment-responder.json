      "id": "fetch-urns-001",
      "name": "Fetch Post URNs",
      "type": "n8n-nodes-base.httpRequest",
      "position": [-176, 480],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const posts = $input.first().json.posts || [];\nreturn posts\n  .filter(p => p.linkedinPostUrn)\n  .map(p => ({\n    json: {\n      postUrn: p.linkedinPostUrn,\n      postText: (p.postText || '').substring(0, 500),\n      postedAt: p.postedAt\n    }\n  }));"
      },
      "id": "extract-posts-001",
      "name": "Extract Posts",
      "type": "n8n-nodes-base.code",
      "position": [48, 480],
      "typeVersion": 2
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batch-001",
      "name": "Loop Posts",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [272, 480],
      "typeVersion": 3
    },
    {
      "parameters": {
        "url": "=https://api.linkedin.com/rest/socialActions/{{ $json.postUrn }}/comments",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "linkedInCommunityManagementOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Linkedin-Version",
              "value": "202501"

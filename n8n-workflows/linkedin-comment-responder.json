      "id": "fetch-comments-001",
      "name": "Fetch Comments",
      "type": "n8n-nodes-base.httpRequest",
      "position": [496, 480],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst elements = input.elements || [];\nconst postUrn = $('Loop Posts').first().json.postUrn;\nconst postText = $('Loop Posts').first().json.postText;\nconst ownOrgUrn = 'urn:li:organization:53520294';\n\n// Filter out own comments and replies (from Freelanly org)\nconst externalComments = elements.filter(c => c.actor !== ownOrgUrn);\n\nif (externalComments.length === 0) {\n  return [{ json: { noComments: true, postUrn } }];\n}\n\nreturn externalComments.map(c => ({\n  json: {\n    commentId: c.id,\n    commentUrn: c.commentUrn || ('urn:li:comment:(' + postUrn + ',' + c.id + ')'),\n    authorUrn: c.actor,\n    commentText: c.message?.text || '',\n    createdTime: c.created?.time || 0,\n    postUrn,\n    postText\n  }\n}));"
      },
      "id": "extract-comments-001",
      "name": "Extract Comments",
      "type": "n8n-nodes-base.code",
      "position": [720, 480],

    {
      "parameters": {
        "method": "POST",
        "url": "https://api.z.ai/api/paas/v4/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 7a46f1755ccb4b828fe35ab83cb81f47.FogYwylFMrNBWEst"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'glm-4-32b-0414-128k', messages: [{ role: 'system', content: 'You are the social media manager for Freelanly.com \\u2014 a platform that aggregates 1000+ fresh remote freelance jobs daily from LinkedIn, Lever, and other sources. You reply to comments on Freelanly\\'s LinkedIn posts. EVERY post is about a specific freelance job opportunity.\\n\\nYour goals:\\n1. Engage the commenter BY NAME (use their first name!)\\n2. If their headline/profession is relevant to the job \\u2014 mention it to personalize\\n3. Encourage them to apply on freelanly.com\\n4. ALWAYS mention signing up for FREE instant job alerts on freelanly.com to never miss similar projects\\n\\nRules:\\n- Reply in the SAME LANGUAGE as the comment\\n- 2-3 sentences max\\n- Start with their name if available (e.g. \\\"Hey John!\\\" or \\\"Thanks Maria!\\\")\\n- If their headline matches the job (e.g. they\\'re a designer and the job is for designers) \\u2014 say something like \\\"This looks like a perfect fit for you!\\\"\\n- Structure: (1) personalized greeting with name, (2) encourage to apply NOW on freelanly.com, (3) mention free instant job alerts for similar projects\\n- ALWAYS end with something about signing up for free instant alerts on freelanly.com\\n- Sound human and friendly, like a helpful community manager\\n- Never just say \\'thanks\\' without the CTA' }, { role: 'user', content: 'Our LinkedIn post was about this job:\\n' + $('Loop Replies').first().json.postText + '\\n\\nCommenter\\'s name: ' + $('Loop Replies').first().json.authorName + '\\nCommenter\\'s headline: ' + ($('Loop Replies').first().json.authorHeadline || 'unknown') + '\\nTheir comment: ' + $('Loop Replies').first().json.commentText + '\\n\\nWrite a personalized reply using their name. Must mention applying on freelanly.com AND signing up for free instant job alerts:' }], temperature: 0.8, max_tokens: 250 }) }}",
        "options": {}
      },

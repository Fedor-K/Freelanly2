      "id": "fetch-comments-001",
      "name": "Fetch Comments",
      "type": "n8n-nodes-base.httpRequest",
      "position": [496, 480],
      "typeVersion": 4.2,
      "credentials": {
        "linkedInCommunityManagementOAuth2Api": {
          "id": "3B9YSIs4S4P9GPv5",
          "name": "LinkedIn Community Management account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst elements = input.elements || [];\nconst postUrn = $('Loop Posts').first().json.postUrn;\nconst postText = $('Loop Posts').first().json.postText;\n\nif (elements.length === 0) {\n  return [{ json: { noComments: true, postUrn } }];\n}\n\nreturn elements.map(c => ({\n  json: {\n    commentId: c.id,\n    commentUrn: c.commentUrn || ('urn:li:comment:(' + postUrn + ',' + c.id + ')'),\n    authorUrn: c.actor,\n    commentText: c.message?.text || '',\n    createdTime: c.created?.time || 0,\n    postUrn,\n    postText\n  }\n}));"
      },
      "id": "extract-comments-001",
      "name": "Extract Comments",
      "type": "n8n-nodes-base.code",
      "position": [720, 480],
      "typeVersion": 2
    },

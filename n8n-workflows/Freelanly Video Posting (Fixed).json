{
  "name": "Freelanly Video Posting (Fixed)",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{"field": "minutes", "minutesInterval": 30}] }
      },
      "id": "trigger",
      "name": "Every 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://freelanly.com/api/cron/post-video-to-social",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer 9c3827de0523441631996ab6f2b012801b8bef944873df5e218fdbf3b6b4552c" }]
        },
        "options": {}
      },
      "id": "get-post",
      "name": "Get Video Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [{ "id": "check", "leftValue": "={{ $json.hasPost }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-post",
      "name": "Has Post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://198.12.73.168:3123/api/short-video",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ scenes: $json.body.scenes, config: $json.body.config }) }}",
        "options": {}
      },
      "id": "create-video",
      "name": "Create Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "videoId", "value": "={{ $json.videoId }}", "type": "string" },
            { "id": "2", "name": "queueItemId", "value": "={{ $('Get Video Post').item.json.body.queueItemId }}", "type": "string" },
            { "id": "3", "name": "jobUrl", "value": "={{ $('Get Video Post').item.json.body.jobUrl }}", "type": "string" },
            { "id": "4", "name": "socialCaption", "value": "={{ $('Get Video Post').item.json.body.socialCaption }}", "type": "string" },
            { "id": "5", "name": "retryCount", "value": "0", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "set-data",
      "name": "Set Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [880, -100]
    },
    {
      "parameters": { "amount": 30, "unit": "seconds" },
      "id": "wait",
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1100, -100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://198.12.73.168:3123/api/short-video/{{ $json.videoId }}",
        "options": { "response": { "response": { "neverError": true, "fullResponse": true } } }
      },
      "id": "check-video",
      "name": "Check Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, -100]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Wait 30s').item.json;\nconst statusCode = $input.first().json.statusCode || 404;\n\nreturn [{\n  json: {\n    isReady: statusCode === 200,\n    statusCode: statusCode,\n    videoId: prev.videoId,\n    queueItemId: prev.queueItemId,\n    jobUrl: prev.jobUrl,\n    socialCaption: prev.socialCaption,\n    retryCount: prev.retryCount\n  }\n}];"
      },
      "id": "process",
      "name": "Process",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, -100]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [{ "id": "ready", "leftValue": "={{ $json.isReady }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-ready",
      "name": "Video Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1760, -100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=http://198.12.73.168:3123/api/short-video/{{ $json.videoId }}",
        "options": { "response": { "response": { "responseFormat": "file" } } }
      },
      "id": "download",
      "name": "Download Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1980, -200]
    },
    {
      "parameters": {
        "chatId": "@PCFTI",
        "text": "={{ $('Process').item.json.socialCaption }}\n\nMore jobs: {{ $('Process').item.json.jobUrl }}",
        "additionalFields": { "appendAttribution": false },
        "operation": "sendVideo"
      },
      "id": "telegram",
      "name": "Post to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [2200, -300],
      "credentials": { "telegramApi": { "id": "qayGIKed5OGXqNmB", "name": "Telegram account" } }
    },
    {
      "parameters": {
        "authentication": "communityManagement",
        "postAs": "organization",
        "organization": "53520294",
        "text": "={{ $('Process').item.json.socialCaption }}\n\nApply: {{ $('Process').item.json.jobUrl }}\n\nMore jobs at freelanly.com",
        "additionalFields": {}
      },
      "id": "linkedin",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [2200, -100],
      "credentials": { "linkedInCommunityManagementOAuth2Api": { "id": "3B9YSIs4S4P9GPv5", "name": "LinkedIn Community Management account" } }
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Process').item.json.socialCaption.substring(0, 100) }}",
        "categoryId": 27,
        "options": {
          "description": "={{ $('Process').item.json.socialCaption }}\n\nApply: {{ $('Process').item.json.jobUrl }}\n\nMore remote jobs at freelanly.com",
          "privacyStatus": "public",
          "tags": "remote jobs, remote work, freelance, hiring, job opportunity"
        }
      },
      "id": "youtube",
      "name": "Post to YouTube",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [2200, 100],
      "credentials": { "youTubeOAuth2Api": { "id": "youtube-creds", "name": "YouTube account" } }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://freelanly.com/api/cron/post-video-to-social",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer 9c3827de0523441631996ab6f2b012801b8bef944873df5e218fdbf3b6b4552c" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ queueItemId: $('Process').item.json.queueItemId, status: 'posted', videoId: $('Process').item.json.videoId }) }}",
        "options": {}
      },
      "id": "mark-posted",
      "name": "Mark Posted",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2420, -200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [{ "id": "retry", "leftValue": "={{ $json.retryCount }}", "rightValue": 20, "operator": { "type": "number", "operation": "lt" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "can-retry",
      "name": "Can Retry?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "1", "name": "videoId", "value": "={{ $json.videoId }}", "type": "string" },
            { "id": "2", "name": "queueItemId", "value": "={{ $json.queueItemId }}", "type": "string" },
            { "id": "3", "name": "jobUrl", "value": "={{ $json.jobUrl }}", "type": "string" },
            { "id": "4", "name": "socialCaption", "value": "={{ $json.socialCaption }}", "type": "string" },
            { "id": "5", "name": "retryCount", "value": "={{ $json.retryCount + 1 }}", "type": "number" }
          ]
        },
        "options": {}
      },
      "id": "inc-retry",
      "name": "Retry +1",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [2200, 0]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "https://freelanly.com/api/cron/post-video-to-social",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "Bearer 9c3827de0523441631996ab6f2b012801b8bef944873df5e218fdbf3b6b4552c" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ queueItemId: $json.queueItemId, status: 'failed', error: 'Timeout after 20 retries (10 min)' }) }}",
        "options": {}
      },
      "id": "mark-failed",
      "name": "Mark Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2200, 150]
    },
    { "parameters": {}, "id": "no-post", "name": "No Post", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [660, 100] },
    { "parameters": {}, "id": "done", "name": "Done", "type": "n8n-nodes-base.noOp", "typeVersion": 1, "position": [2640, -200] }
  ],
  "connections": {
    "Every 30 min": { "main": [[{"node": "Get Video Post", "type": "main", "index": 0}]] },
    "Get Video Post": { "main": [[{"node": "Has Post?", "type": "main", "index": 0}]] },
    "Has Post?": { "main": [ [{"node": "Create Video", "type": "main", "index": 0}], [{"node": "No Post", "type": "main", "index": 0}] ] },
    "Create Video": { "main": [[{"node": "Set Data", "type": "main", "index": 0}]] },
    "Set Data": { "main": [[{"node": "Wait 30s", "type": "main", "index": 0}]] },
    "Wait 30s": { "main": [[{"node": "Check Video", "type": "main", "index": 0}]] },
    "Check Video": { "main": [[{"node": "Process", "type": "main", "index": 0}]] },
    "Process": { "main": [[{"node": "Video Ready?", "type": "main", "index": 0}]] },
    "Video Ready?": { "main": [ [{"node": "Download Video", "type": "main", "index": 0}], [{"node": "Can Retry?", "type": "main", "index": 0}] ] },
    "Download Video": { "main": [ [ {"node": "Post to Telegram", "type": "main", "index": 0}, {"node": "Post to LinkedIn", "type": "main", "index": 0}, {"node": "Post to YouTube", "type": "main", "index": 0} ] ] },
    "Post to Telegram": { "main": [[{"node": "Mark Posted", "type": "main", "index": 0}]] },
    "Mark Posted": { "main": [[{"node": "Done", "type": "main", "index": 0}]] },
    "Can Retry?": { "main": [ [{"node": "Retry +1", "type": "main", "index": 0}], [{"node": "Mark Failed", "type": "main", "index": 0}] ] },
    "Retry +1": { "main": [[{"node": "Wait 30s", "type": "main", "index": 0}]] }
  },
  "settings": { "executionOrder": "v1" }
}

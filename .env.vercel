# ============================================
# FREELANLY - VERCEL ENVIRONMENT VARIABLES
# ============================================
# Copy these to Vercel Dashboard > Settings > Environment Variables
# Generate secrets: openssl rand -base64 32
# ============================================

# ============================================
# CRITICAL - REQUIRED FOR APP TO WORK
# ============================================

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Authentication (NextAuth v5)
AUTH_SECRET=                        # Generate: openssl rand -base64 32
AUTH_URL=https://freelanly.com      # MUST include https://

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe Payments
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx     # From Stripe Dashboard > Webhooks

# Job Sources & Scraping
APIFY_API_TOKEN=                    # Apify.com API token
APOLLO_API_KEY1=                    # Apollo.io enrichment

# AI Provider (for job classification & extraction)
AI_PROVIDER=deepseek                # Options: deepseek | zai
DEEPSEEK_API_KEY=                   # Required if AI_PROVIDER=deepseek
# ZAI_API_KEY=                      # Required if AI_PROVIDER=zai (64% cheaper)

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@freelanly.com

# Cron Authorization
CRON_SECRET=9c3827de0523441631996ab6f2b012801b8bef944873df5e218fdbf3b6b4552c

# Analytics (Frontend - NEXT_PUBLIC_ exposed to browser)
NEXT_PUBLIC_YANDEX_METRIKA_ID=103606747

# ============================================
# RECOMMENDED - FOR FULL FUNCTIONALITY
# ============================================

# SEO & Indexing
INDEXNOW_KEY=                       # IndexNow API key for Bing/Yandex
GOOGLE_INDEXING_CREDENTIALS=        # Base64-encoded service account JSON
GOOGLE_SITE_VERIFICATION=           # HTML tag verification code

# Salary Data APIs
BLS_API_KEY=                        # Bureau of Labor Statistics (US salaries)
ADZUNA_APP_ID=                      # Adzuna salary API
ADZUNA_APP_KEY=

# n8n Integration
N8N_WEBHOOK_SECRET=                 # Webhook validation
APIFY_WEBHOOK_SECRET=               # Fallback for N8N_WEBHOOK_SECRET
N8N_SOCIAL_WEBHOOK_URL=https://n8n.freelanly.com/webhook/xxx

# AI Post Validation
AI_FILTER_ENABLED=true              # Filter non-job posts before processing

# ============================================
# OPTIONAL - NICE TO HAVE
# ============================================

# Additional Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=      # Google Analytics 4
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-11115529529
NEXT_PUBLIC_GADS_CONV_SIGNUP=9-XZCOTLg4UcELmKprQp
NEXT_PUBLIC_GADS_CONV_APPLY=Xw39CP6viYEcELmKprQp
NEXT_PUBLIC_GADS_CONV_SUBSCRIBE=4QvlCIjMlIEcELmKprQp
NEXT_PUBLIC_GADS_CONV_PURCHASE=QPAGCOvngYEcELmKprQp
NEXT_PUBLIC_CLARITY_ID=uqwmja72lg   # Microsoft Clarity (session recording)

# Backend Analytics
YANDEX_METRIKA_TOKEN=               # Backend API access
YANDEX_METRIKA_COUNTER_ID=103606747
CLARITY_API_TOKEN=

# Video Generation (Shotstack)
SHOTSTACK_API_KEY=
SHOTSTACK_OWNER_ID=

# Admin Protection
ADMIN_SECRET=                       # For admin endpoints

# ============================================
# VERCEL-SPECIFIC NOTES
# ============================================
#
# 1. STRIPE WEBHOOK URL:
#    https://freelanly.com/api/stripe/webhook
#    Events: checkout.session.completed, customer.subscription.*, invoice.*
#
# 2. CRON JOBS are configured in vercel.json (see file)
#    Vercel Cron uses Hobby plan (1/day) or Pro plan (unlimited)
#    Pro plan required for: every 5 min, every 15 min, hourly crons
#
# 3. FUNCTION TIMEOUT:
#    Hobby: 10s | Pro: 60s | Enterprise: 900s
#    Some crons (fetch-sources, discover-lever) may need Pro plan
#
# 4. EDGE CONFIG (optional):
#    For faster config reads, consider Vercel Edge Config
#
# 5. DOMAIN SETUP:
#    Add freelanly.com in Vercel Dashboard > Domains
#    Update DNS: CNAME → cname.vercel-dns.com
#
# ============================================

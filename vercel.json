{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 300
    },
    "src/app/api/webhooks/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/post-to-social",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/submit-to-index",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/cleanup-stale-alerts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/cleanup-rejected",
      "schedule": "30 5 * * *"
    },
    {
      "path": "/api/cron/send-auto-apply-digest",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/hot-lead-reminders",
      "schedule": "0 */3 * * *"
    }
  ]
}

{
  "buildCommand": "prisma generate && next build",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/cron/**/*.ts": {
      "maxDuration": 60
    },
    "src/app/api/webhooks/**/*.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/fetch-sources",
      "schedule": "0 6,14,22 * * *"
    },
    {
      "path": "/api/cron/send-trial-emails",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-winback-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/send-nurture",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/post-to-social",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/discover-lever",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/submit-to-index",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/send-abandoned-checkout-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/send-activation-emails",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/send-reengagement-emails",
      "schedule": "0 11 * * *"
    }
  ]
}

# ============================================
# SEMANTIC FEED (self-hosted embeddings — Qwen3-Embedding-0.6B on the Hetzner worker)
# All default to today's lexical behaviour; flip FEED_SEMANTIC_RANK to turn the feed semantic.
# ============================================
EMBED_BASE_URL=http://127.0.0.1:11434/v1   # local Ollama (worker only); TEI would be :8080
EMBED_MODEL=qwen3-embedding:0.6b           # Ollama tag (1024-dim, Apache-2.0)
EMBED_API_KEY=sk-local                     # ignored by the local server
EMBED_DIM=1024
EMBED_VERSION=1                            # bump to force a global re-embed
EMBED_TIMEOUT_MS=120000                    # CPU batches are slow; generous request timeout
FEED_SEMANTIC_RANK=                        # "1"/"on" to rank the feed by meaning (default: lexical)
SEM_FLOOR=0.45                             # min cosine for Good+ (set from calibrate-sem-floor.ts)
HYBRID_W_SEM=0.7                           # weight of semantic vs lexical in the blended score
HYBRID_W_LEX=0.3
EMBED_FILL_BATCH=16                        # embed sub-batch size (keep small — CPU, ~2s/doc)
EMBED_FILL_MAX=500                         # max rows/table per fill tick (worker)
EMBED_STALE_SCAN=200                       # recent users re-checked for stamp staleness per tick
EMBED_OPP_WINDOW_DAYS=14                   # only embed opps/jobs the feed(7d)+quick-apply(14d) can show
EMBED_OPP_DESC_CHARS=500                   # JD chars embedded (title+skills carry most signal)
EMBED_USER_CV_CHARS=700                    # résumé chars embedded

{
  "manifest_version": 3,
  "name": "Freelanly Autofill \u2014 ATS",
  "version": "0.6.0",
  "description": "Autofill job-application (ATS) forms from your Freelanly profile: contact fields, links, resume, and AI-drafted answers. You review.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://freelanly.com/*",
    "https://*.public.blob.vercel-storage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.ashbyhq.com/*",
        "https://apply.workable.com/*",
        "https://jobs.workable.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Freelanly Autofill",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
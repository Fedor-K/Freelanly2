  JOB_APPLY
  JOB_SOURCE_CLICK
  JOB_SAVE
  JOB_SHARE

  // Opportunities (Freelance)
  OPPORTUNITY_VIEW
  OPPORTUNITY_APPLY_CLICK

  // Paywall
  PAYWALL_HIT
  PAYWALL_CLOSE
  UPGRADE_CLICK
  UPGRADE_MODAL_OPEN

  // Pricing & Checkout
  PRICING_VIEW
  PRICING_PLAN_CLICK
  CHECKOUT_START
  CHECKOUT_COMPLETE

  // Search & Filters
  SEARCH
  FILTER_CHANGE

  // Alerts
  ALERT_CREATED
  ALERT_DELETED
  ALERT_EMAIL_OPEN
  ALERT_EMAIL_CLICK

  // Subscription
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED

  // Email
  EMAIL_SENT

  // Chat
  CHAT_MESSAGE

  // Survey
  SURVEY_SENT
  SURVEY_VOTE

  // Other
  PROFILE_UPDATED
  RESUME_UPLOADED
  UNSUBSCRIBE
  CONTACT_VIEW
  REGISTRATION_MODAL_OPEN

  // Auto-Apply
  AUTO_APPLY
  AUTO_APPLY_FOLLOWUP
  LOOP_CREATED
  LOOP_PAUSED
  LOOP_RESUMED
  LOOP_DELETED
  LOOP_UPDATED
  SMTP_CONNECTED
  SMTP_DISCONNECTED
  INBOX_VIEW
  INBOX_REPLY_SENT
  INBOX_AI_SUGGEST
  QUICK_APPLY
  DASHBOARD_VIEW
  SETTINGS_UPDATED
  TEMPLATE_CREATED
  TEMPLATE_DELETED

  // Engagement tracking
  REPLY_VIEWED
  REPLY_EXPANDED
  REPLY_RATED
  RECRUITER_REPLIED
  RECRUITER_PORTAL_VISIT
  RECRUITER_PORTAL_ACTION
  REPLY_EMAIL_OPEN
  REPLY_EMAIL_CLICK
  RESUME_UPDATED
  LOOP_SETTINGS_CHANGED
  ONBOARDING_STEP
  FUNNEL_STEP

  IMPORT_SKIP
}

// ============================================
// EMAIL TRACKING (Resend Webhooks)
// ============================================

model EmailEvent {
  id        String   @id @default(cuid())

  messageId String   // Resend email ID
  type      EmailEventType
  to        String   // Recipient email
  subject   String?  // Email subject

  // Additional metadata (click links, bounce reasons, etc.)
  metadata  Json?

  timestamp DateTime // When event occurred
  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([type])
  @@index([to])
  @@index([timestamp])
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
}

// Alert Email Feedback (👍/👎 кнопки в письмах)
model AlertEmailFeedback {
  id         String   @id @default(cuid())
  userId     String?
  alertId    String?
  emailBatch String?
  rating     String   // "helpful" | "not_helpful"
  category   String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([alertId])
  @@index([createdAt])
}

// ============================================
// AUTO-APPLY
// ============================================

// User's SMTP connection for sending applications
model UserSmtp {
  id          String   @id @default(cuid())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique

  host        String   // smtp.gmail.com, smtp-mail.outlook.com
  port        Int      @default(587)
  email       String   // user's email address
  password    String   // app password (encrypted at application level)
  verified    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Auto-apply "Loop" — a set of filters + settings
model AutoApplyLoop {
  id              String   @id @default(cuid())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  name            String   // "Frontend Remote EU"
  jobTitles       String[] // ["React Developer", "Frontend Engineer"]
  // Professional directions this loop belongs to (1..n of the 21 category slugs). The matcher only
  // considers a loop whose directions match the listing's category (or an adjacent one) — see
  // src/lib/loop-routing.ts. Empty = unclassified → matcher fails open (old "consider everyone").
  categorySlugs   String[] @default([])
  keywords        String?  // comma-separated additional keywords
  country         String?  // ISO country code
  level           String?  // JUNIOR, MID, SENIOR
  salaryMin       Int?
  salaryMax       Int?
  blacklistCompanies String[] // companies to skip
  excludeKeywords    String?  // comma-separated keywords to exclude ("Web3,rockstar,unpaid")


  // Which resume and template to use
  resumeUrl       String?  // URL to PDF resume
  templateId      String?  // CoverLetterTemplate ID

  // Automation settings
  mode            AutoApplyMode @default(AUTO)
  dailyLimit      Int      @default(10)
  sentToday       Int      @default(0)
  lastResetAt     DateTime @default(now())
  isActive        Boolean  @default(true)

  // Match threshold — below this score, require manual review
  matchThreshold  Int      @default(50)  // 0-100

  // Follow-up cadence (days after initial send)
  followUpDay1    Int      @default(4)   // 1st bump after N days
  followUpDay2    Int      @default(8)   // Breakup after N days
  followUpEnabled Boolean  @default(true)

  // Auto-pause conditions
  pauseOnUnanswered  Int?     // Pause if N+ unanswered replies in inbox
  pauseOnLowRate     Float?   // Pause if reply rate drops below X% over 14d
  pauseOnInactive    Int?     // Pause if user hasn't logged in for N days

  // Relations
  applications    AutoApplication[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
}

enum AutoApplyMode {
  AUTO    // Send automatically without confirmation
  SEMI    // Queue for user review before sending
  MANUAL  // Only show matches, don't send
}

// Cover letter template with variables
model CoverLetterTemplate {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  name      String   // "Professional", "Casual"
  subject   String   // Email subject: "Application: {{ job_title }} — {{ your_name }}"
  body      String   // Template body with {{ variables }}
  type      TemplateType @default(APPLICATION)
  isDefault Boolean  @default(false)

  // Performance tracking
  sentCount   Int @default(0)
  replyCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum TemplateType {
  APPLICATION  // Initial application
  FOLLOWUP    // Follow-up after no response
}

// Individual auto-apply attempt (tracks each application sent)
model AutoApplication {
  id              String   @id @default(cuid())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String

  loop            AutoApplyLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)
  loopId          String

  // Applied to (either job or opportunity)
  jobId           String?
  opportunityId   String?

  // What was sent
  companyName     String
  jobTitle        String
  appliedToEmail  String   // recruiter/company email
  coverLetter     String   // generated cover letter text
  subject         String   // email subject line
  resumeUrl       String?  // resume that was attached

  // Match quality
  matchScore      Int?     // 0-100 match score
  matchLabel      String?  // "Strong", "Good", "Weak"
  matchBreakdown  Json?    // frozen verified breakdown {matched,total,wouldGate,bucket,lines,...} — shadow/gate/render

  // Status tracking
  status          AutoApplyStatus @default(PENDING)
  sentVia         String?  // "smtp" or "platform"
  errorMessage    String?

  // Reply tracking
  replyText       String?  // recruiter's reply content
  replyCategory   String?  // INTERESTED, INTERVIEW, REJECTED, OTHER
  replySignal     String?  // AI-extracted signal: "Wants to chat Tue 3pm CET. Caveat: role is full-time."
  repliedAt       DateTime?

  // Follow-up
  followUpSentAt  DateTime?
  followUpCount   Int      @default(0)
  hotLeadReminderAt DateTime?  // when we nudged the user about an unanswered interview invite
  recruiterHidden Boolean @default(false)  // hide from the recruiter portal (off-target match); reversible

  // Timestamps
  sentAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, jobId])
  @@unique([userId, opportunityId])
  @@index([userId, status])
  @@index([loopId])
  @@index([status])
  @@index([createdAt])

  messages   Message[]
}

model Message {
  id              String   @id @default(cuid())

  application     AutoApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String

  from            String   // "user" or "recruiter" or "system"
  text            String
  attachmentUrl   String?

  createdAt       DateTime @default(now())

  @@index([applicationId])
  @@index([applicationId, createdAt])
}

// Demand-side account. A recruiter exists implicitly as AutoApplication.appliedToEmail; this
// row is created when they register through the /r/[token] portal (token already proves inbox
// control, so no OTP). Turns an anonymous email into a known, measurable account: who they are,
// what they hire for (need), and engagement (lastSeenAt). Keyed by email = the token identity.
model Recruiter {
  id            String    @id @default(cuid())
  email         String    @unique   // == AutoApplication.appliedToEmail (lowercased)
  name          String?
  company       String?
  hiringFor     String?             // need Q1 — free text role(s) they're hiring for
  hiringVolume  String?             // need Q2 — "1" | "2-5" | "6-20" | "20+" (budget/volume proxy)
  plan          String    @default("free")
  registeredAt  DateTime  @default(now())
  lastSeenAt    DateTime?            // bumped on each portal visit once registered = engagement signal
}

enum AutoApplyStatus {
  PENDING     // Queued, waiting to send
  REVIEW      // Semi-auto mode, waiting for user approval
  SENDING     // Currently being processed
  SENT        // Successfully sent
  DELIVERED   // Confirmed delivered
  OPENED      // Recruiter opened email
  REPLIED     // Recruiter replied
  INTERVIEW   // Got interview
  OFFER       // Received offer
  SKIPPED     // User manually skipped this project
  REJECTED    // Rejected
  FAILED      // Send failed (SMTP error)
}

// Saved discovery feed (named filter set)
model SavedFeed {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  name      String   // "EU React contracts"
  skills    String[] // ["React", "TypeScript"]
  keywords  String?  // comma-separated
  excludeKeywords String?
  country   String?
  level     String?
  minRate   String?  // "$80/hr"

  color     String?  // dot color in UI

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Shadow paywall (Wave 2). Logs every time a recruiter reveals a candidate's real contact
// from the portal. During validation reveal is FREE but recorded here, so when monetization
// flips on we already know demand (who reveals, how often) and can gate it behind payment.
// Standalone (string refs, no FK) to keep the migration purely additive.
model ContactReveal {
  id             String   @id @default(cuid())
  applicationId  String   // AutoApplication whose candidate was revealed
  recruiterEmail String   // == AutoApplication.appliedToEmail (lowercased)
  revealedAt     DateTime @default(now())

  @@unique([applicationId, recruiterEmail])
  @@index([recruiterEmail])
  @@index([applicationId])
}

// Recruiter addresses we must stop sending auto-apply outreach to: one-click List-Unsubscribe
// opt-outs (RFC 8058) and, later, hard bounces. Honoring unsubscribe + suppressing dead
// addresses protects the apply@ domain reputation so legitimate applications keep landing.
// Standalone (string ref, no FK) → purely additive migration; the send loop fails OPEN if the
// table isn't there yet, so a pending migration never blocks outreach.
model RecruiterSuppression {
  email     String   @id // lowercased recruiter email
  reason    String   @default("optout") // "optout" | "bounce" | "complaint"
  createdAt DateTime @default(now())
}

// Short-lived OTP for recruiter passwordless login (email + 6-digit code → session cookie).
// Lets recruiters re-enter their portal without hunting for the email link. Code is stored
// hashed; one active row per email (upsert). Standalone, additive migration.
model RecruiterOtp {
  email     String   @id // lowercased recruiter email
  codeHash  String   // sha256 of the 6-digit code (never store the code itself)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTH (NextAuth.js v5)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Auth (password for migrated users, null for magic link only)
  password      String?   // bcrypt hash from old system

  // Payment integration
  paymentProvider     String?   // 'stripe' or 'paypro'
  stripeId            String?   @unique
  stripeSubscriptionId String?  // Active Stripe subscription ID
  payproOrderId       String?   // PayPro order ID
  payproSubscriptionId String?  // PayPro subscription ID
  plan                Plan      @default(FREE)
  subscriptionEndsAt  DateTime? // When current period ends

  // Limits tracking
  jobViewsToday Int       @default(0)
  lastViewReset DateTime  @default(now())

  // Resume
  resumeUrl      String?
  resumeText     String?   // Extracted text from PDF
  resumeBase64   String?   // PDF file as base64 for email attachment
  resumeFileName String?   // Original filename
  resumeGenerated Boolean  @default(false) // true = PDF auto-built from parsedProfile (no real upload); a real upload overwrites it
  parsedProfile  Json?     // AI-extracted: {name, skills, current_title, field, experience_years, summary}
  linkedinUrl    String?   // Candidate's LinkedIn profile URL (collected at apply; used for enrichment + recruiter view)

  // Profile (used in outreach personalization)
  workPreference String?   // "What kind of work do you want?" — free text, guides AI cover letters
  headline       String?   // One sentence, credibility — "Senior React dev · ex-Notion"
  location       String?   // "Berlin, Germany"
  availability   String?   // "~30 hrs/week"
  availableFrom  String?   // "mid-November", "immediately"
  rateFloorHourly Int?     // Minimum $/hr — auto-skip jobs below this
  rateFloorProject Int?    // Minimum $/project — auto-skip below
  salaryExpectation   String?   // candidate-stated expected pay (post-submit, SELF-REPORTED) — soft context in the breakdown, never a verified/statused line
  salaryExpectationAt DateTime? // when stated — render must de-emphasize / decay stale self-reports (same freshness discipline as everywhere)
  portfolioUrl   String?   // candidate-entered portfolio / GitHub / personal site — recruiters ask for it (14%); shown on the application card
  caseStudies    Json?     // ["notion-sync", "crdt-merge"] — AI picks best per outreach

  // Voice training (3 sample emails for AI to match writing style)
  voiceSamples   Json?     // ["sample email 1", "sample email 2", "sample email 3"]

  // Timezone & send schedule
  timezone       String?   // "Europe/Berlin", "America/New_York"
  sendStartHour  Int?      // 9 (9am)
  sendEndHour    Int?      // 17 (5pm)
  sendWeekdaysOnly Boolean @default(true) // Mon-Fri only

  // Notification preferences
  notifyOnReply  Boolean   @default(true)
  notifyDigest   Boolean   @default(true)  // Daily digest email
  notifySlackUrl String?   // Slack webhook URL
  telegramChatId String?   // Telegram chat ID for notifications
  bookingUrl     String?   // Calendly/Cal.com link

  // Activity tracking
  lastActiveAt  DateTime?  // For re-engagement emails

  // Onboarding (for Google OAuth users who skip registration form)
  needsOnboarding Boolean @default(false)

  // Activation tracking (for new PRO users)
  activatedAt           DateTime?  // When first application was sent
  activationEmailsSent  Int @default(0)  // 0=none, 1=welcome, 2=day1, 3=day2, 4=day3
  lastActivationEmailAt DateTime?
  proStartedAt          DateTime?  // When user became PRO (for tracking 7-day window)

  // FREE user nurture tracking (drip emails to convert to PRO)
  freeNurtureEmailsSent  Int @default(0)  // 0=none, 1=welcome, 2=day3, 3=day7
  lastFreeNurtureEmailAt DateTime?
  nurtureEmailVariant    String?          // A/B/C - which DAY_7 variant they received

  // FOMO email tracking (sent 3 days after registration)
  fomoEmailSentAt        DateTime?        // When FOMO email was sent (null = not sent)

  // Email preferences
  unsubscribedFromMarketing Boolean @default(false)  // User opted out of marketing emails
  unsubscribedAt            DateTime?                 // When they unsubscribed
  // NOTE: job-alert opt-in (jobAlertOptIn / jobAlertOptInAt) lives in the DB (see
  // scripts/wave2-migrate.sql) but is intentionally NOT in this model. It's written via guarded
  // raw SQL in the register route so a not-yet-applied migration can't break site-wide User reads.

  // Legal compliance (for dispute evidence)
  agreedToTermsAt           DateTime?                 // When user agreed to ToS

  // Google Ads attribution
  gclid                     String?                   // Google Click ID for offline conversion tracking

  // Registration traffic source
  source                    String?                   // linkedin, telegram, twitter, job_alert, google, direct
  utmMedium                 String?                   // utm_medium (cpc, email, social, organic)
  utmCampaign               String?                   // utm_campaign (campaign name)
  utmContent                String?                   // utm_content (specific ad/post)

  // Conversion tracking (UTM at moment of purchase)
  conversionSource          String?                   // utm_source at purchase time
  conversionMedium          String?                   // utm_medium at purchase time
  conversionCampaign        String?                   // utm_campaign at purchase time
  conversionAt              DateTime?                 // when the purchase happened

  // Relations
  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  jobAlerts     JobAlert[]
  applyAttempts ApplyAttempt[]
  cookieConsents CookieConsent[]
  reengagementEmails ReengagementEmail[]

  // Auto-Apply
  userSmtp              UserSmtp?
  autoApplyLoops        AutoApplyLoop[]
  autoApplications      AutoApplication[]
  coverLetterTemplates  CoverLetterTemplate[]
  savedFeeds            SavedFeed[]
  freeAppliesUsedToday  Int       @default(0)
  lastFreeApplyReset    DateTime  @default(now())
  appsUsedThisCycle     Int       @default(0)   // Applications sent this billing cycle
  cycleStartedAt        DateTime  @default(now()) // When current billing cycle started
  emailBounceCount      Int       @default(0)   // Hard bounces, disable alerts after 3

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Cancellation feedback
  cancellationFeedback CancellationFeedback[]
}

// Cancellation survey feedback
model CancellationFeedback {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  reason    CancellationReason
  otherText String?  // If reason is OTHER, user can explain
  feedback  String?  // Additional comments

  // Subscription info at time of cancellation
  planAtCancellation String?  // weekly, monthly, annual
  subscriptionId     String?  // Stripe subscription ID

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reason])
  @@index([createdAt])
}

enum CancellationReason {
  TOO_EXPENSIVE       // Price is too high
  NOT_ENOUGH_JOBS     // Not enough relevant jobs
  FOUND_JOB           // Found a job (success!)
  NOT_USING           // Not using the service enough
  MISSING_FEATURES    // Missing features I need
  TECHNICAL_ISSUES    // Technical problems
  POOR_JOB_QUALITY    // Jobs don't match my skills
  OTHER               // Other reason
}

// NextAuth Account (for OAuth providers)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// NextAuth Session (for database sessions)
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// NextAuth Verification Token (for magic link + OTP code)
model VerificationToken {
  identifier String
  token      String   @unique
  code       String?  // 6-digit OTP code (alternative to magic link)
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier, code])
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// ============================================
// COMPANIES
// ============================================

model Company {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  logo          String?
  website       String?
  description   String?

  // Company details
  size          CompanySize?
  industry      String?
  foundedYear   Int?
  headquarters  String?

  // LinkedIn
  linkedinUrl   String?
  linkedinId    String?

  // ATS integration
  atsType       ATSType?
  atsId         String?      // board token for ATS

  // Verification
  verified      Boolean      @default(false)

  // Apollo enrichment tracking
  apolloEnrichedAt DateTime?  // When enriched (null = not tried yet)

  // Relations
  jobs          Job[]
  opportunities Opportunity[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([slug])
  @@index([name])
}

enum CompanySize {
  STARTUP      // 1-10
  SMALL        // 11-50
  MEDIUM       // 51-200
  LARGE        // 201-1000
  ENTERPRISE   // 1000+
}

enum ATSType {
  GREENHOUSE
  LEVER
  ASHBY
  WORKABLE
  BAMBOO
  JOBVITE
  SMARTRECRUITERS
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  description   String?     // SEO description
  icon          String?     // Icon name or emoji

  // Hierarchy
  parentId      String?
  parent        Category?   @relation("SubCategories", fields: [parentId], references: [id])
  children      Category[]  @relation("SubCategories")

  // SEO
  metaTitle     String?
  metaDescription String?

  // Stats (updated daily)
  jobCount      Int         @default(0)
  avgSalary     Int?

  // Relations
  jobs          Job[]
  opportunities Opportunity[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([slug])
  @@index([parentId])
}

// ============================================
// JOBS
// ============================================

model Job {
  id            String      @id @default(cuid())
  slug          String      @unique

  // Basic info
  title         String
  description   String      // Original description or post text

  // Company
  company       Company     @relation(fields: [companyId], references: [id])
  companyId     String

  // Category
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String

  // Location
  location      String?     // "Remote", "New York, USA", etc
  locationType  LocationType @default(REMOTE)
  country       String?     // ISO code: "US", "DE", etc
  city          String?
  timezone      String?     // "PST", "CET", etc

  // Job details
  level         Level       @default(MID)
  type          JobType     @default(FULL_TIME)

  // Salary
  salaryMin     Int?
  salaryMax     Int?
  salaryCurrency String?    @default("USD")
  salaryPeriod  SalaryPeriod @default(YEAR)
  salaryIsEstimate Boolean  @default(false)

  // Skills/tags
  skills        String[]    // ["React", "TypeScript", "Node.js"]
  benefits      String[]    // ["Health insurance", "401k", "Remote"]

  // Translation-specific fields (only for translation category jobs)
  translationTypes   TranslationType[]  // Types of translation work
  sourceLanguages    String[]           // ISO codes: ["EN", "ES", "DE"]
  targetLanguages    String[]           // ISO codes: ["RU", "FR", "ZH"]

  // Source tracking
  source        Source
  sourceType    SourceType  @default(STRUCTURED)
  sourceUrl     String      // Original URL
  sourceId      String?     // ID in source system

  // LinkedIn-specific (for posts)
  originalContent String?   // Original post text
  authorLinkedIn  String?   // Post author's LinkedIn URL
  authorName      String?   // Post author name
  authorTitle     String?   // "Engineering Manager at Linear"
  authorCompany   String?   // Company from LinkedIn profile
  authorFollowers Int?      // LinkedIn follower count
  authorHeadline  String?   // LinkedIn headline

  // AI-structured description (for SEO and UX)
  cleanDescription   String?    // AI-generated clean, readable description text
  summaryBullets     String[]   @default([])  // 5-7 key responsibilities
  requirementBullets String[]   @default([])  // 5-7 requirements
  benefitBullets     String[]   @default([])  // benefits if mentioned

  // Application
  applyUrl      String?     // Direct apply URL
  applyEmail    String?     // Email to apply

  // Processing status
  enrichmentStatus EnrichmentStatus @default(COMPLETED)
  qualityScore     Int       @default(50)
  contentQuality   ContentQuality @default(RICH)  // SEO quality tier
  companyVerified  Boolean   @default(false)

  // Direct opportunity (freelance from LinkedIn - urgent, client needs NOW)
  isDirectOpportunity Boolean @default(false)

  // Visibility
  isActive      Boolean     @default(true)
  isFeatured    Boolean     @default(false)

  // Dates
  postedAt      DateTime
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  applications  Application[]
  alertNotifications AlertNotification[]
  socialPosts   SocialPostQueue[]
  videoPosts    VideoPostQueue[]
  applyAttempts ApplyAttempt[]
  importedJobs  ImportedJob[]

  @@unique([companyId, title], name: "unique_job_title_per_company")
  @@index([categoryId])
  @@index([companyId])
  @@index([postedAt(sort: Desc)])
  @@index([isActive, postedAt(sort: Desc)])
  @@index([source])
  @@index([level])
  @@index([locationType])
  @@index([country])
}

enum LocationType {
  REMOTE        // Fully remote, worldwide
  REMOTE_US     // Remote, US only
  REMOTE_EU     // Remote, Europe only
  REMOTE_COUNTRY // Remote, specific country
  HYBRID        // Hybrid
  ONSITE        // On-site only
}

enum Level {
  INTERN
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
}

enum SalaryPeriod {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
  ONE_TIME
}

enum Source {
  LINKEDIN          // LinkedIn posts (via Apify)
  GREENHOUSE        // Greenhouse ATS
  LEVER             // Lever ATS
  ASHBY             // Ashby ATS
  WORKABLE          // Workable ATS
  BAMBOO            // BambooHR
  SMARTRECRUITERS   // SmartRecruiters
  WORKDAY           // Workday
  RSS               // RSS feeds
  MANUAL            // Manually added
  SCRAPE            // Web scraping
  REMOTIVE          // Remotive API
  ARBEITNOW         // Arbeitnow API
  HIMALAYAS         // Himalayas API
  WORKINGNOMADS     // WorkingNomads
  INDEED            // Indeed API
}

enum SourceType {
  STRUCTURED    // From ATS with full data
  UNSTRUCTURED  // From LinkedIn posts, needs extraction
}

enum EnrichmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Content quality for SEO (THIN = noindex, LIGHT/RICH = index)
enum ContentQuality {
  THIN   // Short posts, no details - noindex, not in sitemap
  LIGHT  // Medium quality - index with lower priority
  RICH   // Full description - index with high priority
}

// Translation-specific enums for language professionals
enum TranslationType {
  TRANSLATION     // Written translation
  INTERPRETATION  // Oral/verbal interpretation
  LOCALIZATION    // Software/content localization
  EDITING         // Editing/proofreading
  TRANSCRIPTION   // Audio/video transcription
  SUBTITLING      // Subtitling/captioning
  MT_POST_EDITING // Machine translation post-editing
  COPYWRITING     // Multilingual copywriting
}

// ============================================
// KEYWORD RUN TRACKING (LinkedIn Search)
// ============================================

model KeywordRun {
  id              String   @id @default(cuid())

  keyword         String              // Search keyword used
  keywordIndex    Int                 // Index 0-76

  status          KeywordRunStatus @default(STARTED)

  // Stats
  postsReceived       Int @default(0)     // Posts received from Apify
  postsProcessed      Int @default(0)     // Passed isJobPosting validation
  opportunitiesCreated Int @default(0)    // Actually created

  // Timestamps
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  // Relations
  opportunities   Opportunity[]

  @@index([keyword])
  @@index([startedAt(sort: Desc)])
  @@index([status])
}

enum KeywordRunStatus {
  STARTED
  COMPLETED
  FAILED
}

// ============================================
// OPPORTUNITIES (LinkedIn Direct Projects)
// ============================================

model Opportunity {
  id              String   @id @default(cuid())
  slug            String   @unique

  // === CLIENT/AUTHOR INFO (The Key Difference from Jobs) ===
  clientName      String              // Author name (person or company posting)
  clientLinkedIn  String              // Author's LinkedIn URL (source of trust)
  clientType      String              // 'profile' or 'company'
  clientHeadline  String?             // e.g., "CTO at TechCorp"
  clientAvatar    String?             // Avatar URL

  // Enriched poster profile (from LinkedIn scrape)
  posterTitle     String?             // Full title from LinkedIn profile
  posterCompany   String?             // Company from LinkedIn profile
  posterFollowers Int?                // LinkedIn follower count

  // === ORIGINAL CONTENT ===
  originalContent String   @db.Text   // Raw LinkedIn post text

  // === EXTRACTED JOB DATA ===
  title           String
  description     String   @db.Text   // AI-cleaned description

  // === OPTIONAL COMPANY (extracted, not fabricated) ===
  company         Company? @relation(fields: [companyId], references: [id])
  companyId       String?

  // === CATEGORY & LOCATION ===
  category        Category @relation(fields: [categoryId], references: [id])
  categoryId      String
  location        String?
  locationType    LocationType @default(REMOTE)
  country         String?

  // === JOB DETAILS ===
  level           Level @default(MID)
  type            JobType @default(FREELANCE)
  skills          String[]

  // === TRANSLATION-SPECIFIC ===
  translationTypes TranslationType[]
  sourceLanguages String[]
  targetLanguages String[]

  // === SALARY ===
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  salaryPeriod    SalaryPeriod @default(HOUR)
  salaryIsEstimate Boolean @default(true)

  // === APPLY INFO ===
  applyEmail      String?
  applyUrl        String?

  // NOTE: column "matchedAt" (TIMESTAMP, nullable) also exists on this table in the DB.
  // It is intentionally NOT declared here and is managed via idempotent raw SQL in
  // src/services/auto-apply-processor.ts (ensureMatcherSchema). Declaring it would make
  // the generated Prisma client SELECT it in every Opportunity read, 500-ing the app on
  // any deploy that lands before the column exists. Do NOT add it here; if you run
  // `prisma db push` it may try to drop it — the matcher re-creates it (one-time re-scan).

  // === SOURCE ===
  sourceUrl       String              // LinkedIn post URL
  sourceId        String?             // LinkedIn post ID

  // === KEYWORD TRACKING ===
  sourceKeyword   String?             // Which keyword found this post
  keywordRun      KeywordRun? @relation(fields: [keywordRunId], references: [id], onDelete: SetNull)
  keywordRunId    String?

  // === QUALITY & VISIBILITY ===
  contentQuality  ContentQuality @default(LIGHT)
  qualityScore    Int @default(50)
  isActive        Boolean @default(true)

  // === DATES ===
  postedAt        DateTime
  expiresAt       DateTime?           // 14 days default (shorter than jobs)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // === RELATIONS ===
  alertNotifications AlertNotification[]
  socialPostQueue    SocialPostQueue[]
  applyAttempts      ApplyAttempt[]

  @@index([categoryId])
  @@index([companyId])
  @@index([postedAt(sort: Desc)])
  @@index([isActive, postedAt(sort: Desc)])
  @@index([clientLinkedIn])
  @@index([keywordRunId])
  @@index([sourceKeyword])
}

// ============================================
// APPLICATIONS
// ============================================

model Application {
  id            String    @id @default(cuid())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String

  // Application content
  coverLetter   String?
  resumeUrl     String?

  // Status tracking
  status        ApplicationStatus @default(SENT)

  // Email tracking
  emailMessageId String?  // For tracking

  // Timestamps
  sentAt        DateTime  @default(now())
  openedAt      DateTime?
  repliedAt     DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
}

enum ApplicationStatus {
  DRAFT
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  REJECTED
  INTERVIEW
  OFFER
  HIRED
  WITHDRAWN
}


// ============================================
// SEO LANDING PAGES
// ============================================

model LandingPage {
  id            String    @id @default(cuid())
  slug          String    @unique

  // Filters that define this page
  categorySlug  String?
  location      String?
  level         String?
  jobType       String?

  // SEO content
  title         String
  h1            String
  metaDescription String
  content       String?   // Additional page content for SEO

  // Stats (updated via cron)
  jobCount      Int       @default(0)
  avgSalary     Int?

  // Control
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([categorySlug])
}

// ============================================
// JOB ALERTS / SUBSCRIBERS
// ============================================

model JobAlert {
  id            String    @id @default(cuid())
  email         String

  // User relation (optional - can be anonymous or linked to user)
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?

  // Preferences
  category      String?   // Category slug filter
  keywords      String?   // Keywords to match
  country       String?   // Country filter
  level         String?   // Level filter (JUNIOR, MID, SENIOR)
  frequency     AlertFrequency @default(INSTANT)

  // Translation-specific: multiple language pairs per alert
  languagePairs AlertLanguagePair[]

  // Notifications sent
  notifications AlertNotification[]

  // Status
  isActive      Boolean   @default(true)

  // Stats
  lastSentAt    DateTime?
  emailsSent    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, email, category, keywords]) // Prevent duplicate alerts
  @@index([email])
  @@index([userId])
  @@index([isActive])
}

// Language pair for translation job alerts
// Example: user wants alerts for Written EN→RU, Written EN→DE, Interpretation DE→RU
model AlertLanguagePair {
  id              String    @id @default(cuid())

  jobAlert        JobAlert  @relation(fields: [jobAlertId], references: [id], onDelete: Cascade)
  jobAlertId      String

  translationType String    // TRANSLATION, INTERPRETATION, LOCALIZATION, etc.
  sourceLanguage  String    // ISO 639-1: EN, RU, DE
  targetLanguage  String    // ISO 639-1: RU, EN, DE

  createdAt       DateTime  @default(now())

  @@unique([jobAlertId, translationType, sourceLanguage, targetLanguage])
  @@index([jobAlertId])
}

enum AlertFrequency {
  INSTANT   // Queue for next batch (processed every 5-10 min)
}

enum NotificationStatus {
  PENDING     // Queued, waiting to be sent
  PROCESSING  // Being processed (lock to prevent race conditions)
  SENT        // Successfully sent
}

// Track which jobs/opportunities have been sent to which alerts (to prevent duplicates)
// Also serves as queue for INSTANT alerts (status=PENDING)
model AlertNotification {
  id          String    @id @default(cuid())

  jobAlert    JobAlert  @relation(fields: [jobAlertId], references: [id], onDelete: Cascade)
  jobAlertId  String

  // Either job OR opportunity (one must be set)
  job           Job?          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?

  status      NotificationStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  sentAt      DateTime?  // When actually sent (null if pending)
  messageId   String?    // Resend email ID — links webhook events to this notification

  @@unique([jobAlertId, jobId])  // Prevent sending same job twice to same alert
  @@unique([jobAlertId, opportunityId])  // Prevent sending same opportunity twice
  @@index([jobAlertId])
  @@index([jobId])
  @@index([opportunityId])
  @@index([status, createdAt])  // For queue processing
  @@index([messageId])           // For joining with EmailEvent
}

// ============================================
// JOB IMPORT TRACKING
// ============================================

model ImportLog {
  id            String    @id @default(cuid())

  source        Source
  status        ImportStatus @default(RUNNING)

  // Link to data source for company name
  dataSourceId  String?
  dataSource    DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)

  // Stats
  totalFetched  Int       @default(0)
  totalNew      Int       @default(0)
  totalUpdated  Int       @default(0)
  totalSkipped  Int       @default(0)
  totalFailed   Int       @default(0)

  // Error tracking
  errors        Json?     // Array of error messages

  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  // Relations
  filteredJobs  FilteredJob[]
  importedJobs  ImportedJob[]

  @@index([source])
  @@index([dataSourceId])
  @@index([startedAt(sort: Desc)])
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Queue for background processing of data sources
model ImportTask {
  id            String       @id @default(cuid())

  // Link to data source
  dataSource    DataSource   @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  dataSourceId  String

  // Status
  status        TaskStatus   @default(PENDING)
  priority      Int          @default(0)  // Higher = process first

  // Progress tracking
  totalJobs     Int          @default(0)  // Total jobs found
  processedJobs Int          @default(0)  // Jobs processed so far
  createdJobs   Int          @default(0)  // Jobs created
  skippedJobs   Int          @default(0)  // Jobs skipped

  // Error handling
  error         String?
  retryCount    Int          @default(0)
  maxRetries    Int          @default(3)

  // Timestamps
  createdAt     DateTime     @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  // Link to ImportLog when processing starts
  importLogId   String?

  @@index([status])
  @@index([priority(sort: Desc), createdAt])
  @@index([dataSourceId])
}

enum TaskStatus {
  PENDING     // Waiting to be processed
  PROCESSING  // Currently being processed
  COMPLETED   // Successfully completed
  FAILED      // Failed after max retries
  CANCELLED   // Manually cancelled
}

// Tracking for search engine indexing submissions
model IndexingLog {
  id          String   @id @default(cuid())
  provider    String   // "GOOGLE" | "INDEXNOW"
  urlsCount   Int      // Number of URLs submitted
  success     Int      @default(0)
  failed      Int      @default(0)
  error       String?  // Error message if any
  createdAt   DateTime @default(now())

  @@index([provider, createdAt])
  @@index([createdAt])
}

// Filtered jobs - stored for 20 days for debugging
model FilteredJob {
  id            String       @id @default(cuid())

  // Link to import run
  importLog     ImportLog    @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  importLogId   String

  // Job info (what was filtered)
  title         String
  company       String       // Company name at time of filtering
  location      String?
  sourceUrl     String?      // Original URL if available

  // Filter reason
  reason        FilterReason

  // Raw data for debugging (optional)
  rawData       Json?

  createdAt     DateTime     @default(now())

  @@index([importLogId])
  @@index([reason])
  @@index([createdAt])
}

enum FilterReason {
  NON_TARGET_TITLE      // Medical, food, logistics, etc.
  PHYSICAL_LOCATION     // On-site job, specific city
  DUPLICATE             // Exact duplicate by sourceUrl or title+company
  SIMILAR_EXISTS        // Fuzzy duplicate (same email domain + similar title)
  NO_TITLE              // AI couldn't extract title
  NO_EMAIL              // No corporate email found
  SPAM                  // Announcement, not a job
  TOO_OLD               // Job older than 7 days (MAX_JOB_AGE_DAYS)
  AI_REJECTED           // AI filter rejected (travel, healthcare, etc.)
  OTHER                 // Other reason
}

// Track which jobs were created in each import run
model ImportedJob {
  id            String       @id @default(cuid())

  // Link to import run
  importLog     ImportLog    @relation(fields: [importLogId], references: [id], onDelete: Cascade)
  importLogId   String

  // Link to created job
  job           Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String

  createdAt     DateTime     @default(now())

  @@unique([importLogId, jobId])
  @@index([importLogId])
  @@index([jobId])
}

// ============================================
// DATA SOURCES
// ============================================

model DataSource {
  id            String       @id @default(cuid())

  // Display info
  name          String       // "Appen", "Netflix", etc.

  // Source type
  sourceType    Source       // LEVER, GREENHOUSE, LINKEDIN, etc.

  // For ATS sources - company identifier
  companySlug   String?      // "appen", "netflix" (null for aggregators)

  // API configuration
  apiUrl        String?      // Full API URL (auto-generated or custom)
  apiKey        String?      // API key if needed
  config        Json?        // Additional settings

  // Status
  isActive      Boolean      @default(true)

  // Stats
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  totalImported Int          @default(0)
  lastCreated   Int          @default(0)  // Jobs created in last run
  lastFetched   Int          @default(0)  // Jobs fetched in last run (before filtering)
  lastError     String?
  errorCount    Int          @default(0)

  // Rate limiting
  minInterval   Int          @default(3600) // Min seconds between runs

  // Quality & Scoring
  tags          String[]     // ["tech", "healthcare", "retail", "finance"]
  score         Float?       // 0-100 quality score
  conversionRate Float?      // % of fetched jobs that pass whitelist
  qualityStatus String?      // "high", "medium", "low"
  lastScoreAt   DateTime?    // When score was last calculated
  weeklyImported Int         @default(0)  // Jobs imported in last 7 days

  // Relations
  importLogs    ImportLog[]
  importTasks   ImportTask[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([sourceType, companySlug]) // Can't have duplicate company for same ATS
  @@index([sourceType])
  @@index([isActive])
  @@index([score])
  @@index([qualityStatus])
}

// ============================================
// SALARY BENCHMARKS (Cache for salary market data)
// ============================================

model SalaryBenchmark {
  id            String   @id @default(cuid())

  // Search key - normalized job title + location
  jobTitle      String   // Normalized title (e.g., "software engineer")
  country       String   // ISO code: "US", "UK", "DE", etc.
  region        String   @default("") // State/region for more specific data (empty = national)

  // Salary data (annual, in USD)
  minSalary     Int
  maxSalary     Int
  avgSalary     Int
  medianSalary  Int
  percentile25  Int
  percentile75  Int
  sampleSize    Int      // Number of data points used

  // Source tracking
  source        SalarySource
  sourceCode    String?  // BLS SOC code, Adzuna category, etc.
  rawResponse   Json?    // Original API response for debugging

  // Cache management
  createdAt     DateTime @default(now())
  expiresAt     DateTime // When this cache entry expires

  @@unique([jobTitle, country, region])
  @@index([jobTitle])
  @@index([country])
  @@index([expiresAt])
}

enum SalarySource {
  BLS           // US Bureau of Labor Statistics
  ADZUNA        // Adzuna salary predictor
  CALCULATED    // Calculated from our job database
  ESTIMATED     // AI/coefficient-based estimation
}

// ============================================
// SETTINGS (Key-Value Store)
// ============================================

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

// ============================================
// CEO ANALYTICS - Metrics & KPIs
// ============================================

model DailyMetric {
  id        String   @id @default(cuid())
  date      DateTime @db.Date // YYYY-MM-DD

  // === TRAFFIC METRICS ===
  pageViews        Int @default(0)
  uniqueVisitors   Int @default(0)
  jobPageViews     Int @default(0)
  companyPageViews Int @default(0)

  // === USER METRICS ===
  newSignups       Int @default(0)
  activeUsers      Int @default(0)  // Users who visited
  returningUsers   Int @default(0)

  // === CONVERSION METRICS ===
  trialStarts      Int @default(0)
  paidConversions  Int @default(0)
  churns           Int @default(0)

  // === REVENUE METRICS (in cents) ===
  newMRR           Int @default(0)  // New subscriptions
  churnedMRR       Int @default(0)  // Lost from churns
  expansionMRR     Int @default(0)  // Upgrades
  netMRR           Int @default(0)  // End of day MRR

  // === ENGAGEMENT METRICS ===
  jobApplications  Int @default(0)
  emailAlertSubs   Int @default(0)

  // === CONTENT METRICS ===
  newJobs          Int @default(0)
  expiredJobs      Int @default(0)
  newCompanies     Int @default(0)

  // === SEO METRICS ===
  googleImpressions Int @default(0)
  googleClicks      Int @default(0)
  indexedPages      Int @default(0)

  // === OPERATIONAL METRICS ===
  importRuns       Int @default(0)
  importSuccesses  Int @default(0)
  importFailures   Int @default(0)
  apiCostsCents    Int @default(0)  // Apify, Z.ai, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

model MonthlyTarget {
  id        String   @id @default(cuid())
  month     DateTime @db.Date // First day of month

  // === REVENUE TARGETS ===
  targetMRR        Int      // Target MRR in cents
  actualMRR        Int?     // Actual MRR achieved

  // === GROWTH TARGETS ===
  targetSignups    Int
  actualSignups    Int?

  targetPaidUsers  Int
  actualPaidUsers  Int?

  targetJobs       Int
  actualJobs       Int?

  // === NOTES ===
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([month])
}

model RevenueEvent {
  id        String   @id @default(cuid())

  // Event type
  type      RevenueEventType

  // Amount in cents
  amount    Int
  currency  String   @default("USD")

  // Related entities
  userId    String?
  planFrom  Plan?
  planTo    Plan?

  // Stripe reference
  stripeEventId     String?   @unique
  stripeCustomerId  String?
  stripeSubscriptionId String?

  // Metadata
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([userId])
}

enum RevenueEventType {
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELLED
  SUBSCRIPTION_CHURNED
  ONE_TIME_PAYMENT
  REFUND
}

model CEOAlert {
  id        String   @id @default(cuid())

  type      AlertType
  severity  AlertSeverity

  title     String
  message   String

  // For metrics-based alerts
  metricName String?
  threshold  Float?
  actualValue Float?

  // Status
  isRead    Boolean  @default(false)
  isDismissed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([severity])
  @@index([createdAt])
}

enum AlertType {
  REVENUE_DROP
  CHURN_SPIKE
  CONVERSION_DROP
  TRAFFIC_ANOMALY
  SYSTEM_ERROR
  MILESTONE_REACHED
  TARGET_AT_RISK
  OPPORTUNITY
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

// ============================================
// SOCIAL POST QUEUE
// ============================================

model SocialPostQueue {
  id          String    @id @default(cuid())

  // Job reference (optional - for regular jobs)
  job         Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String?

  // Opportunity reference (optional - for freelance projects)
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?

  // Generated content (cached to avoid re-generating)
  postText    String?   @db.Text

  // Status
  status      SocialPostStatus @default(PENDING)

  // Tracking
  postedAt         DateTime?
  linkedinPostUrn  String?    // URN of the LinkedIn post (e.g. urn:li:share:123) — for comment monitoring
  error            String?

  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([opportunityId])
}

enum SocialPostStatus {
  PENDING     // Waiting in queue
  POSTED      // Successfully posted
  FAILED      // Failed to post
  SKIPPED     // Skipped (e.g., duplicate, low quality)
}

// ============================================
// LINKEDIN COMMENT REPLIES (auto-responder tracking)
// ============================================

model LinkedInCommentReply {
  id          String   @id @default(cuid())
  commentId   String   @unique  // LinkedIn comment ID — prevents double replies
  postUrn     String             // Which LinkedIn post this comment was on
  commentText String   @db.Text  // Original comment text
  aiReply     String   @db.Text  // AI-generated reply text
  repliedAt   DateTime @default(now())

  @@index([postUrn])
}

// ============================================
// VIDEO POST QUEUE
// ============================================

model VideoPostQueue {
  id          String    @id @default(cuid())

  // Job reference
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId       String

  // Video info (after generation)
  videoId     String?   // VPS video ID
  videoUrl    String?   // Full URL to video

  // Status (reuses SocialPostStatus)
  status      SocialPostStatus @default(PENDING)

  // Tracking
  postedAt    DateTime?
  error       String?

  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([createdAt])
}

// ============================================
// APPLY ATTEMPTS (for conversion tracking)
// ============================================

// Track when FREE users try to apply (for nurturing emails)
model ApplyAttempt {
  id        String   @id @default(cuid())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Either job OR opportunity (one must be set)
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId         String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  opportunityId String?

  // Email nurture tracking
  nurtureEmailSent Boolean  @default(false)
  nurtureEmailSentAt DateTime?
  converted        Boolean  @default(false) // Did they upgrade?
  convertedAt      DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([jobId])
  @@index([opportunityId])
  @@index([nurtureEmailSent, createdAt]) // For cron: find unsent
}

// ============================================
// COOKIE CONSENT (GDPR compliance)
// ============================================

model CookieConsent {
  id        String   @id @default(cuid())

  // User relation (optional - can be anonymous)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
visitorId String?  // For anonymous users (fingerprint or random ID)

  // Consent details
  necessary   Boolean @default(true)  // Always true, required cookies
  analytics   Boolean @default(false) // Google Analytics, Yandex Metrika
  marketing   Boolean @default(false) // Ads, remarketing
  preferences Boolean @default(false) // Language, theme preferences

  // Metadata
  ipAddress   String?
  userAgent   String?
  consentedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // For tracking consent changes
  version     Int @default(1) // Consent policy version

  userId      String?

  @@index([userId])
  @@index([visitorId])
  @@index([consentedAt])
}

// ============================================
// TRIAL EMAIL ONBOARDING
// ============================================

// Track trial onboarding emails sent to users
model TrialEmail {
  id        String   @id @default(cuid())

  // User reference (by Stripe customer ID, not our user - they might not exist yet)
  stripeCustomerId String
  email            String

  // Which email was sent
  emailType TrialEmailType

  // Tracking
  sentAt    DateTime @default(now())
  openedAt  DateTime?  // If we track opens via pixel

  // Stripe subscription info at time of sending
  trialStartDate DateTime
  trialEndDate   DateTime

  @@unique([stripeCustomerId, emailType]) // One email of each type per customer
  @@index([stripeCustomerId])
  @@index([email])
  @@index([emailType])
  @@index([sentAt])
}

enum TrialEmailType {
  DAY_0_WELCOME       // Welcome email on trial start
  DAY_2_FEATURES      // Feature highlight
  DAY_5_SOCIAL_PROOF  // Testimonials and success stories
  DAY_6_URGENCY       // Trial ending tomorrow
  DAY_7_LAST_CHANCE   // Last day reminder
}

// ============================================
// RETENTION & WIN-BACK
// ============================================

// Track retention offers applied (discount, pause)
model RetentionOffer {
  id        String   @id @default(cuid())

  // User reference
  userId    String
  email     String

  // What was offered
  offerType RetentionOfferType
  accepted  Boolean  @default(true)

  // Stripe info
  stripeSubscriptionId String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([offerType])
  @@index([createdAt])
}

enum RetentionOfferType {
  DISCOUNT_50     // 50% off next month
  PAUSE_1_MONTH   // Pause for 1 month
}

// Track win-back emails sent to churned users
model WinbackEmail {
  id        String   @id @default(cuid())

  // User reference (by email, user might have deleted account)
  email            String
  stripeCustomerId String?

  // Which email was sent
  emailType WinbackEmailType

  // Tracking
  sentAt    DateTime @default(now())
  openedAt  DateTime?
  clickedAt DateTime?

  // Did they come back?
  resubscribedAt DateTime?

  // Subscription info at time of churn
  canceledAt     DateTime
  planAtCancel   String?

  abVariant      String?          // A/B/C test variant

  @@unique([email, emailType]) // One email of each type per user
  @@index([email])
  @@index([emailType])
  @@index([sentAt])
}

enum WinbackEmailType {
  DAY_7_MISS_YOU      // 7 days after cancel: "We miss you"
  DAY_14_SPECIAL_OFFER // 14 days: Special discount offer
  DAY_30_LAST_CHANCE   // 30 days: Last chance offer
}

// Track checkout sessions for abandoned cart recovery
model CheckoutSession {
  id        String   @id @default(cuid())

  // Stripe session reference
  stripeSessionId String   @unique
  email           String
  userId          String?

  // Plan info
  priceKey        String   // monthly, quarterly, annual
  amount          Int?     // Amount in cents

  // Source tracking
  source          String?  // job_page, opportunity_page, pricing_page, etc.
  jobId           String?
  opportunityId   String?

  // Status
  status          CheckoutStatus @default(PENDING)
  completedAt     DateTime?
  abandonedEmailSentAt DateTime?  // When first abandoned email was sent

  createdAt       DateTime @default(now())

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum CheckoutStatus {
  PENDING    // Checkout started, not completed
  COMPLETED  // Payment successful
  EXPIRED    // Session expired without payment
}

// Abandoned Checkout Email tracking
model AbandonedCheckoutEmail {
  id        String   @id @default(cuid())

  // Stripe session reference
  sessionId String
  email     String

  // Which email was sent
  emailType AbandonedCheckoutEmailType

  // Tracking
  sentAt    DateTime @default(now())
  openedAt  DateTime?
  clickedAt DateTime?

  // Did they convert?
  convertedAt DateTime?

  abVariant   String?          // A/B/C test variant

  @@unique([sessionId, emailType]) // One email of each type per session
  @@index([email])
  @@index([emailType])
  @@index([sentAt])
}

enum AbandonedCheckoutEmailType {
  MINUTE_10  // 10 minutes after: Immediate recovery
  HOUR_1     // 1 hour after: "Complete your checkout"
  HOUR_24    // 24 hours: "Your trial is waiting"
  DAY_3      // 3 days: "Last chance + discount"
}

// ============================================
// BLOG
// ============================================

model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique

  // Content
  title         String
  excerpt       String?           // Short description for cards
  content       String   @db.Text // Full article content (Markdown/HTML)

  // Category
  category      BlogCategory @relation(fields: [categorySlug], references: [slug])
  categorySlug  String

  // SEO
  metaTitle       String?         // Custom meta title (defaults to title)
  metaDescription String?         // <=155 chars
  keywords        String[]        // For meta keywords
  canonicalUrl    String?         // If republished from elsewhere

  // OG Image
  ogImage       String?           // Custom OG image URL
  ogImageAlt    String?           // Alt text for OG image

  // Structure (auto-generated)
  tableOfContents Json?           // [{level: 2, text: "...", id: "..."}]
  readingTime     Int   @default(5) // Minutes

  // FAQ for schema (extracted from content)
  faqItems      Json?             // [{question: "...", answer: "..."}]

  // Author (for E-E-A-T)
  authorName    String  @default("Freelanly Team")
  authorImage   String?
  authorBio     String?

  // Status
  status        BlogPostStatus @default(DRAFT)
  publishedAt   DateTime?
  featuredAt    DateTime?       // If featured, when it was featured

  // Stats
  viewCount     Int     @default(0)

  // Relations
  relatedPosts  String[]        // Array of related post slugs

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([categorySlug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([featuredAt(sort: Desc)])
}

model BlogCategory {
  slug          String   @id      // "salary-guides", "remote-job-hunting"
  name          String            // "Salary Guides"
  description   String?           // Category description for SEO
  icon          String?           // Emoji or icon name

  // SEO
  metaTitle       String?
  metaDescription String?

  // Stats
  postCount     Int      @default(0)

  // Relations
  posts         BlogPost[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
}

enum BlogPostStatus {
  DRAFT         // Not visible
  PUBLISHED     // Live on site
  ARCHIVED      // Hidden but not deleted
}

// ============================================
// RE-ENGAGEMENT EMAILS
// ============================================

model ReengagementEmail {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailType ReengagementEmailType

  sentAt    DateTime @default(now())
  openedAt  DateTime?
  clickedAt DateTime?

  @@unique([userId, emailType])
  @@index([userId])
  @@index([emailType])
  @@index([sentAt])
}

enum ReengagementEmailType {
  DAY_7_INACTIVE
  DAY_14_INACTIVE
  DAY_30_INACTIVE
}

// ============================================
// UNLOCKED CONTACTS (pay-per-contact)
// ============================================

model UnlockedContact {
  id        String   @id @default(cuid())
  userId    String
  // Either a job or an opportunity
  jobId           String?
  opportunityId   String?
  // Payment info
  stripeSessionId String?
  payproOrderId   String?
  amount          Int      @default(300) // cents
  currency        String   @default("EUR")

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@unique([userId, opportunityId])
  @@index([userId])
}

// ============================================
// ACTIVITY LOG (for dispute evidence)
// ============================================

model ActivityLog {
  id        String   @id @default(cuid())

  // User reference (optional - can be anonymous)
  userId    String?

  // Action details
  action    ActivityAction
  details   Json?    // Additional context: { jobId: "xxx", etc. }

  // Request info (for fraud evidence)
  ipAddress   String?
  userAgent   String?
  country     String?  // Derived from IP
  city        String?

  // Session tracking
  sessionId   String?

  // Page URL where the action happened
  pageUrl     String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([ipAddress])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([userId, action])
}

enum ActivityAction {
  // Auth
  LOGIN
  LOGOUT
  SIGNUP
  SIGNUP_START
  SIGNUP_COMPLETE
  EMAIL_VERIFIED
  PASSWORD_RESET

  // Navigation
